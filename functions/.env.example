# Copy to functions/.env only for local Firebase emulator/development use.
# Never commit functions/.env or put real values in this file.
# Production values must be stored in Firebase/Google Cloud secret management.

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=https://your-project.livekit.cloud
GEMINI_API_KEY=
EGRESS_BUCKET=your-gcp-bucket
# One-line JSON service-account credential used by LiveKit egress workers.
GCP_EGRESS_CREDENTIALS=
# Keep false during the beta. Enabling this starts an egress per participant
# and requires a LiveKit plan/capacity review.
ENABLE_SPEAKER_TRACKS=false
